# ========================================
# CONFIGURATION APACHE - SÉCURITÉ
# Compatible PrestaShop 1.6.1.11
# ========================================

# ----------------------------------------
# HEADERS DE SÉCURITÉ HTTP
# ----------------------------------------
<IfModule mod_headers.c>
    # Protection contre MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Protection contre clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Protection XSS navigateur (legacy)
    Header always set X-XSS-Protection "1; mode=block"
    
    # Cache control pour les ressources statiques
    <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    
    # Pas de cache pour les API
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# ----------------------------------------
# PROTECTION DES FICHIERS SENSIBLES
# ----------------------------------------

# Interdire l'accès aux fichiers de configuration
<FilesMatch "\.(json|log|bak|backup|sql|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Interdire l'accès aux répertoires sensibles
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^data/ - [F,L]
    RewriteRule ^config/ - [F,L]
    RewriteRule ^src/ - [F,L]
    RewriteRule ^api/common/ - [F,L]
    RewriteRule ^\.git - [F,L]
</IfModule>

# ----------------------------------------
# DÉSACTIVER LE LISTING DES RÉPERTOIRES
# ----------------------------------------
Options -Indexes

# ----------------------------------------
# COMPRESSION GZIP (Performance)
# ----------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# ----------------------------------------
# PROTECTION CONTRE HOTLINKING IMAGES
# ----------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Autoriser uniquement votre domaine + domaines staging
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?votre-domaine\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?localhost [NC]
    RewriteRule \.(jpg|jpeg|png|gif|svg)$ - [F,NC]
</IfModule>

# ----------------------------------------
# LIMITE DE TAILLE UPLOAD (Sécurité)
# ----------------------------------------
 #php_value upload_max_filesize 10M
 #php_value post_max_size 10M
